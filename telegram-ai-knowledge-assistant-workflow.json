    {
      "parameters": {
        "jsCode": "// Get the user's question from the Edit Fields node\nconst userQuestion = ($(\"Edit Fields\").first().json.question || \"\").toLowerCase();\n\n// All rows coming from Google Sheets\nconst rows = $input.all();\n\nlet bestMatch = null;\nlet highestScore = 0;\n\nfor (const row of rows) {\n  const question = (row.json.Question || \"\").toLowerCase();\n  const keywords = (row.json.Keywords || \"\").toLowerCase();\n\n  let score = 0;\n  const words = userQuestion.split(\" \");\n\n  // Count how many words from the question appear in the sheet's\n  // Question or Keywords columns\n  for (const word of words) {\n    if (question.includes(word)) score++;\n    if (keywords.includes(word)) score++;\n  }\n\n  if (score > highestScore) {\n    highestScore = score;\n    bestMatch = row.json;\n  }\n}\n\nif (!bestMatch) {\n  return [{\n    json: {\n      question: userQuestion,\n      matchedQuestion: \"\",\n      matchedAnswer: \"\",\n      score: 0\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    question: userQuestion,\n    matchedQuestion: bestMatch.Question,\n    matchedAnswer: bestMatch.Answer,\n    score: highestScore\n  }\n}];"
      },
      "id": "37b6e29b-2519-467b-aeb1-8b6b9bdf656c",
